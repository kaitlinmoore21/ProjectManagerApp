<!-- app/views/tasks/index.html.erb -->
<div class="container">
  <h1>
    Tasks
    <% if @project %>
      for <%= @project.name %>
    <% else %>
      (All Projects)
    <% end %>
  </h1>

  <% if @project %>
    <%= link_to "New Task", new_project_task_path(@project), class: "btn btn-primary" %>
  <% end %>
  <%= link_to "Back to Projects", projects_path, class: "btn btn-edit" %>

  <table>
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Status</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @tasks.each do |task| %>
        <tr class="hover:bg-gray-50">
          <td class="border px-2 py-1"><%= task.name %></td>
          <td class="border px-2 py-1"><%= truncate(task.description, length: 50) %></td>
          <td class="border px-2 py-1"><%= task.status %></td>
          <td class="border px-2 py-1 flex gap-2">
            <% if @project %>
              <%= link_to 'Show', project_task_path(@project, task), class: "btn btn-primary" %>
              <%= link_to 'Edit', edit_project_task_path(@project, task), class: "btn btn-edit" %>
              <%= button_to 'Destroy', project_task_path(@project, task), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
            <% else %>
              <%= link_to 'Show', task_path(task), class: "btn btn-primary" %>
              <%= link_to 'Edit', edit_task_path(task), class: "btn btn-edit" %>
              <%= button_to 'Destroy', task_path(task), method: :delete, data: { confirm: 'Are you sure?' }, class: "btn btn-danger" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
